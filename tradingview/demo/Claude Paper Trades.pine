//@version=6
indicator("Claude Paper Trades (DEMO 30 Sep)", overlay = false, precision = 0, max_labels_count = 500, max_lines_count = 500)
// Generated 2026-10-01 00:42 UTC from the paper account (MyFundedFutures Rapid 50K (evaluation)). Simulated money only.
// Trades for the symbol on this chart (MNQ, MES...) are drawn on the price chart; the panel shows the balance.

showVwap = input.bool(true, "Show session VWAP with ±1σ bands")
[vw, vwUp, vwLo] = ta.vwap(hlc3, timeframe.change("1D"), 1.0)
plot(showVwap ? vw : na, "VWAP", color = color.new(color.blue, 0), force_overlay = true)
plot(showVwap ? vwUp : na, "VWAP +1σ", color = color.new(color.green, 30), force_overlay = true)
plot(showVwap ? vwLo : na, "VWAP -1σ", color = color.new(color.green, 30), force_overlay = true)

var pts_t = array.from(1790775620000, 1790776820000, 1790777460000, 1790780420000, 1790783340000, 1790789420000, 1790789940000, 1790794820000, 1790799000000)
var pts_v = array.from(50000.0, 49997.75, 49815.5, 49814.0, 49732.5, 49731.0, 49629.5, 49628.0, 49090.5)
var int idx = 0
while idx + 1 < array.size(pts_t) and array.get(pts_t, idx + 1) <= time_close
    idx += 1
equity = time_close >= array.get(pts_t, 0) ? array.get(pts_v, idx) : na
plot(equity, "Balance", color = color.teal, linewidth = 2, style = plot.style_stepline)
hline(50000.0, "Start", color = color.gray, linestyle = hline.style_dotted)
hline(53000.0, "Profit target", color = color.green, linestyle = hline.style_dashed)
hline(48000.0, "Max-loss floor (now)", color = color.red, linestyle = hline.style_dashed)

var sym_c = array.from("MNQ", "MES", "MNQ", "MNQ")
var side_c = array.from("long", "short", "short", "long")
var qty_c = array.from(3.0, 2.0, 2.0, 2.0)
var tin_c = array.from(1790776820000, 1790780420000, 1790789420000, 1790794820000)
var pin_c = array.from(30849.25, 7770.75, 30796.5, 30820.75)
var tout_c = array.from(1790777460000, 1790783340000, 1790789940000, 1790799000000)
var pout_c = array.from(30819.25, 7778.75, 30821.5, 30686.75)
var pnl_c = array.from(-180.0, -80.0, -100.0, -536.0)
var when_in = array.from("10:00 AM ET", "11:00 AM ET", "1:30 PM ET", "3:00 PM ET")
var when_out = array.from("10:11 AM ET", "11:49 AM ET", "1:39 PM ET", "4:10 PM ET")

if barstate.islast
    for i = 0 to array.size(sym_c) - 1
        if array.get(sym_c, i) == syminfo.root
            pnl = array.get(pnl_c, i)
            longTrade = array.get(side_c, i) == "long"
            col = pnl >= 0 ? color.new(color.green, 0) : color.new(color.red, 0)
            line.new(array.get(tin_c, i), array.get(pin_c, i), array.get(tout_c, i), array.get(pout_c, i), xloc = xloc.bar_time, color = col, width = 2, style = line.style_dashed, force_overlay = true)
            label.new(array.get(tin_c, i), array.get(pin_c, i), (longTrade ? "BUY " : "SELL ") + str.tostring(array.get(qty_c, i)) + " @ " + str.tostring(array.get(pin_c, i)) + "\n" + array.get(when_in, i), xloc = xloc.bar_time, style = longTrade ? label.style_label_up : label.style_label_down, color = longTrade ? color.new(color.blue, 0) : color.new(color.orange, 0), textcolor = color.white, size = size.small, force_overlay = true)
            label.new(array.get(tout_c, i), array.get(pout_c, i), (pnl >= 0 ? "+$" : "-$") + str.tostring(math.abs(pnl), "#,##0") + "\n" + array.get(when_out, i), xloc = xloc.bar_time, style = longTrade ? label.style_label_down : label.style_label_up, color = col, textcolor = color.white, size = size.small, force_overlay = true)

var tbl = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 15), border_width = 1, force_overlay = true)
if barstate.islast
    table.cell(tbl, 0, 0, "Account", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 0, "MyFundedFutures Rapid 50K (evaluation)", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 0, 1, "Balance", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 1, "$49,090.50", text_color = color.white, text_size = size.small, text_halign = text.align_left)
