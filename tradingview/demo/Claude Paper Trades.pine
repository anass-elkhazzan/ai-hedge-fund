    table.cell(tbl, 0, 4, "Max-loss floor", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 4, "$48,000.00 (room $1,090.50)", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 0, 5, "Closed trades", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 5, "4 (0 wins), win rate 0%", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 0, 6, "Status", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 6, "trading allowed", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 0, 7, "Updated", text_color = color.silver, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 7, "2026-10-01 00:42 UTC", text_color = color.white, text_size = size.small, text_halign = text.align_left)

var log = table.new(position.bottom_right, 8, 5, bgcolor = color.new(color.black, 15), border_width = 1, force_overlay = true)
